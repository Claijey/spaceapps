# NASA Space Apps 2026 - Environment Configuration
# Add these in .env.local for local development or Vercel Environment Variables in production.

# NASA Open API Key (Used for live DONKI space weather: FLR, SEP, CME)
VITE_NASA_API_KEY=DEMO_KEY

# Supabase Realtime Backend (Used for Universal Multi-Device Leaderboard & Clan System)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
